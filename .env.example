# Copy to .env and fill in. Every value here is optional except the
# reMarkable pairing, which rmapi writes for you.

# --- device ---------------------------------------------------------------
# Path to the rmapi binary (https://github.com/ddvk/rmapi). Pair it once with
# `rmapi` before first use.
RMAPI_BIN=rmapi

# Where your projects live on the tablet. The default is the device root --
# "My files" -- so a project is simply a top-level folder you name, created on
# first push. Point it at a folder if you keep projects together.
RM_MCP_PROJECTS_ROOT=/
# The notes tree. Same default; only a desk that keeps notes apart from its
# projects needs it to differ.
RM_ROOT=/

# Folders rm_move, rm_delete and rm_push_dir may touch (and, on the network
# lane, the only folders that can be read at all). Defaults to the projects
# root (plus RM_ROOT when set) -- and at "/" that is the WHOLE DEVICE. rm_health reports
# guard_scope as "whole device" so it is never silently wide open; narrow it
# to the folders you actually use, as a comma-separated list.
# RM_MCP_MANAGED_ROOTS=/Thesis,/Notes

# Shape of a project folder name under RM_MCP_PROJECTS_ROOT. Default: any
# single folder name. The author's desk uses NNN_name (e.g. 100_thesis),
# which also lets the server detect the project from the working directory;
# set the same pattern to get that behaviour.
# RM_MCP_PROJECT_PATTERN=^\d{3}_[A-Za-z0-9][A-Za-z0-9_\-]*$

# Where this server may look outside the managed roots. Reads are confined to
# them on the network lane; set this to 1 to allow whole-device browsing there
# (rm_diff walks every tree, so a local stdio server does this by default).
# RM_MCP_ALLOW_READ_ANYWHERE=1

# Override the substrate script location for an unusual layout. Detected
# automatically for both the standalone and embedded trees.
# RM_MCP_TOOLS_DIR=

# --- reMarkable cloud throttling --------------------------------------------
# rmapi is unofficial, and the reMarkable cloud answers too many logins with
# HTTP 429. Any failure makes rmapi re-mint its login token, so retrying a 429
# makes it worse. Every tool here therefore runs ONE rmapi call at a time,
# and after a 429 refuses to call the cloud at all until a cooldown ends.
# rm_health reports the cooldown without calling the cloud.
#
# Seconds every tool waits after a 429 before calling the cloud again.
# RM_THROTTLE_COOLDOWN_S=300
# Seconds a call waits for another tool's rmapi call before giving up.
# RM_RMAPI_LOCK_TIMEOUT_S=600
# Minimum seconds between one rmapi call ending and the next starting. A
# burst of quick calls draws a 429 even one at a time. 0 turns pacing off.
# RM_RMAPI_MIN_INTERVAL_S=2
# rmapi's own request fan-out when it re-syncs changed documents. rmapi
# defaults to 20; this toolkit sets 4 unless you set it here.
# RMAPI_CONCURRENT=4
# Where the cooldown record and the lock live. Default: beside the scripts.
# Move them when that directory is read-only.
# RM_RMAPI_THROTTLE_FILE=
# RM_RMAPI_LOCK_FILE=

# --- surface --------------------------------------------------------------
# Which tools this deployment exposes: core (21, device infrastructure) or
# remote (7, the hosted wire surface). Unset picks the right default for your
# build, so you usually do not need this.
# RM_MCP_SURFACE=core

# --- transport ------------------------------------------------------------
# stdio (default) is a local, trusted registration and needs nothing below.
# streamable-http exposes the server on the network, where reads are confined
# to the managed roots and every request must present a token.
# RM_MCP_TRANSPORT=streamable-http
# RM_MCP_HOST=0.0.0.0
# RM_MCP_PORT=8000        (PORT is also honoured, for platforms that inject it)

# --- tokens (network lane) -------------------------------------------------
# SCOPED. Set as many as you need; the server refuses to start on
# streamable-http with none of them. Each must be a DIFFERENT secret -- the
# same string in two slots resolves to the higher scope, so that is a hard
# startup error rather than a silent promotion.
#
#   read    everything that does not change the device: list, diff, pull,
#           render, page images, highlight extraction, vision interpretation
#   write   read + everything that creates: pushes and folders
#   admin   write + rm_move and rm_delete, the two tools that can unmake a
#           library
#
# Give a caller the lowest scope that does its job. The point of the split is
# that a leaked read token cannot wipe the device, and a leaked write token
# cannot either.
# RM_MCP_READ_TOKEN=
# RM_MCP_WRITE_TOKEN=
# RM_MCP_ADMIN_TOKEN=
#
# The auth header is `x-api-key`; `Authorization: Bearer <token>` in that same
# header is also accepted. Change the header name if your client insists.
# RM_MCP_AUTH_HEADER=x-api-key
#
# DEPRECATED. The single unscoped token, kept so existing deployments keep
# working. It grants write, or admin when RM_MCP_ALLOW_DESTRUCTIVE is also
# set. Prefer the scoped tokens above -- issuing an admin token is the modern
# spelling of that toggle, and it names WHICH caller may destroy rather than
# enabling destruction for everyone holding the one secret.
# RM_MCP_AUTH_TOKEN=
# RM_MCP_ALLOW_DESTRUCTIVE=1

# --- network access control -------------------------------------------------
# Comma-separated addresses and/or CIDR blocks allowed to reach the server.
# Unset means no allowlist. A malformed entry is a startup error, never a
# silently dropped rule. /health stays reachable so platform probes work.
# RM_MCP_ALLOWED_IPS=203.0.113.4,198.51.100.0/24,2001:db8::/32
#
# Behind a proxy or load balancer the socket peer is the PROXY, so the
# allowlist would see one address for everyone. Set this to read the client
# address from X-Forwarded-For instead -- but ONLY with a trusted proxy in
# front, because without one the caller names their own source address.
# The value is read from the RIGHT of the header (what the nearest trusted
# proxy appended), never the client-supplied leftmost entry. One hop is
# correct for Cloud Run and most single-LB setups.
# RM_MCP_TRUST_FORWARDED_FOR=1
# RM_MCP_FORWARDED_HOPS=1

# --- rate limiting ----------------------------------------------------------
# Two sliding-window buckets per client address. The second one is tighter
# because the expensive failure is memory, not request volume: page
# rasterisation and vision interpretation allocate bitmaps and leave output
# dirs resident, so a caller comfortably inside the general limit can still
# walk an instance into an OOM using nothing but rm_render. Set either to 0 to
# disable it. Per-process, so N instances enforce it N times over.
# RM_MCP_RATE_LIMIT=120
# RM_MCP_HEAVY_RATE_LIMIT=12
# RM_MCP_RATE_WINDOW_SECONDS=60
#
# Largest request body accepted. Buffered before authentication (the tool name
# has to be read to know what scope the call needs), so it is bounded.
# RM_MCP_MAX_BODY_BYTES=16777216

# --- memory / output retention ----------------------------------------------
# Every render, flatten and pull writes artifacts to a per-call directory under
# the session dir. On a container with a RAM-backed filesystem those count
# against the memory limit, so all but the newest KEEP_OUTPUTS are evicted when
# a new one is created.
#
# Defaults differ by transport on purpose: 40 on stdio, where a co-located
# agent reads those paths across later turns, and 2 on streamable-http, where
# the paths name the container's own filesystem and are useless to the caller
# anyway. Raise it if a workflow reads back many outputs; lower it if an
# instance runs hot.
# RM_MCP_KEEP_OUTPUTS=40
#
# A directory younger than this is NEVER evicted, whatever the queue depth --
# two concurrent callers on one instance would otherwise let the second evict
# a path the first was just told to read. Excess held this way is retained and
# counted, not deleted: rm_health reports it as retained_in_grace. Defaults to
# 300 on streamable-http and 0 on stdio, where a single caller means no race.
# RM_MCP_OUTPUT_GRACE_SECONDS=300
#
# Old per-process session dirs are pruned at startup (newest 20, plus anything
# under 14 days). Set to `all` to keep every one of them.
# RM_MCP_KEEP_SESSIONS=all
#
# Asynchronous project pull (rm_pull_project_start / _status / _fetch). A job
# renders one page per subprocess, so peak memory is one page, not the whole
# document. Finished pages stay fetchable until the job's TTL, and a job that
# stops updating expires the same way. On a RAM-backed disk the TTL is the
# lever for what is retained. Default 3600 (one hour).
# RM_MCP_JOB_TTL_SECONDS=3600
# Pages rendered at once by one job. Default 1, hard ceiling 2.
# RM_MCP_PULL_PAGE_WORKERS=1
# Where jobs keep their pages. Default: a jobs/ folder beside the per-call
# output dirs, reaped by TTL rather than by the output count above.
# RM_MCP_JOBS_DIR=

# --- literature services ----------------------------------------------------
# Contact address sent as the mailto in the User-Agent by the literature tools
# that call CrossRef and OpenAlex. Unset means the anonymous pool: correct, but
# slower and rate-limited harder. Use your own address -- it is what those
# services contact if your tooling misbehaves.
# CROSSREF_CONTACT_EMAIL=you@example.com

# --- vision (RM_MCP_SURFACE=full only) --------------------------------------
# Vision backend for handwriting interpretation, used only by tools that are
# not on the core surface. Neither is needed for a core deployment.
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# Gemini model ids, one place for the whole toolkit (rm_config.py). Leave
# unset for the defaults; override when Google retires a generation (the
# 2.5 models locked out new projects in 2026-09) or to pin a specific id.
# GEMINI_FLASH_MODEL=
# GEMINI_PRO_MODEL=
